{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile for NovaStream",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated user UID" },
        "displayName": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "description": "User email address" },
        "photoUrl": { "type": "string", "description": "Profile avatar URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp via serverTimestamp" }
      },
      "required": ["userId", "email"]
    },
    "LibraryItem": {
      "title": "LibraryItem",
      "description": "Saved movie or series in user watchlist with progress tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Media item ID" },
        "userId": { "type": "string", "description": "Authenticated user UID" },
        "type": { "type": "string", "description": "Media type e.g. movie, series" },
        "name": { "type": "string", "description": "Title of media item" },
        "poster": { "type": "string", "description": "Poster image URL" },
        "background": { "type": "string", "description": "Backdrop image URL" },
        "releaseInfo": { "type": "string", "description": "Release year or date" },
        "imdbRating": { "type": "string", "description": "Rating score" },
        "status": { "type": "string", "description": "Watch status: WATCHING, PLAN_TO_WATCH, COMPLETED, FAVORITE" },
        "watchPositionMs": { "type": "number", "description": "Playback position in milliseconds" },
        "durationMs": { "type": "number", "description": "Duration in milliseconds" },
        "lastEpisodeId": { "type": "string", "description": "ID of last watched episode" },
        "lastEpisodeTitle": { "type": "string", "description": "Title of last watched episode" },
        "lastWatchedTimestamp": { "type": "number", "description": "Client epoch millis of last interaction" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp via serverTimestamp" }
      },
      "required": ["id", "userId", "name", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account document"
    },
    "/users/{userId}/library/{itemId}": {
      "schema": "LibraryItem",
      "description": "User's synchronized library items"
    }
  }
}
